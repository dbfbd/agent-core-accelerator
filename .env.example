INCIDENT_AGENT_RUNBOOK_DIR=knowledge/runbooks
INCIDENT_AGENT_MCP_COMMAND=
INCIDENT_AGENT_MCP_ARGS_JSON=[]
INCIDENT_AGENT_HOST=127.0.0.1
INCIDENT_AGENT_PORT=8000
